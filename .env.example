# Supabase configuration (Web app)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# B2B Lead Generator Configuration
# Google Places API Key (from Google Cloud Console)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Optional: Google Sheets Export (used with --sheets)
GOOGLE_SHEETS_CREDENTIALS_FILE=service_account.json
GOOGLE_SHEET_TITLE=B2B Leads Outreach
# Alternatively, specify sheet ID directly:
# GOOGLE_SHEET_ID=your_spreadsheet_id_here
